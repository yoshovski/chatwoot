# Lab activation is explicit. Never reuse production credentials in a lab.
CWAI_ENABLED=false
CWAI_DATABASE_URL=postgresql+psycopg://cwai:cwai@localhost:5432/cwai
# For compose: set a random password and use ai-db instead of localhost in the URL.
# CWAI_DB_PASSWORD=replace-with-a-random-database-password
# CWAI_API_PORT=8010
CWAI_INSTALLATION_ID=chatwoot-lab
CWAI_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters
CWAI_ORIGINALS_PATH=/data/originals
CWAI_DIFY_CONNECTIONS={"lab":{"url":"http://dify-api:5001/v1","api_key":"replace-with-a-lab-knowledge-key","embedding_provider":"configure-provider","embedding_model":"configure-model","reranking_provider":"configure-provider","reranking_model":"rerank-2.5"}}
