<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= t('onboarding_email_settings.title') %></title>
  </head>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #F4F7FB; color: #0F172A; margin: 0; padding: 48px 16px;">
    <main style="max-width: 480px; margin: 0 auto; background: #FFFFFF; border-radius: 24px; padding: 32px;">
      <h1 style="font-size: 20px; margin: 0 0 12px;"><%= t('onboarding_email_settings.title') %></h1>
      <p style="margin: 0 0 24px; line-height: 22px;">
        <%= t(@account_user.onboarding_emails? ? 'onboarding_email_settings.on' : 'onboarding_email_settings.off', account: @account_user.account.name) %>
      </p>
      <%= form_tag onboarding_emails_path, method: :post do %>
        <%= hidden_field_tag :token, params[:token] %>
        <%= hidden_field_tag :enabled, (!@account_user.onboarding_emails?).to_s %>
        <%= submit_tag t(@account_user.onboarding_emails? ? 'onboarding_email_settings.turn_off' : 'onboarding_email_settings.turn_on'),
                       style: 'background: #2781F6; color: #FFFFFF; border: 0; border-radius: 14px; padding: 12px 24px; font-weight: 700; cursor: pointer;' %>
      <% end %>
    </main>
  </body>
</html>
