<% content_for(:title) do %>Shopify Connection Requests<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Shopify Connection Requests</h1>
</header>

<section class="main-content__body">
  <p class="text-sm text-slate-600 mb-6">
    Manage custom-app Shopify connections for accounts. Approve submitted shop domains, provision Shopify Agent Tools tenants, and generate client installation links.
  </p>

  <% if @hooks.empty? %>
    <div class="border border-slate-100 rounded-md p-8 bg-slate-25 text-center text-slate-600">
      No Shopify connection requests found.
    </div>
  <% else %>
    <div class="overflow-x-auto border border-slate-100 rounded-md">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-600 uppercase">
            <th class="p-3">Account</th>
            <th class="p-3">Shop Domain</th>
            <th class="p-3">State</th>
            <th class="p-3">SAT Tenant</th>
            <th class="p-3">Requested / Approved</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @hooks.each do |hook| %>
            <% state = hook.shopify_state %>
            <tr class="hover:bg-slate-25">
              <td class="p-3 font-medium text-slate-800">
                <%= link_to hook.account.name, super_admin_account_path(hook.account), class: 'text-brand-600 hover:underline' %>
                <span class="text-xs text-slate-500">(ID <%= hook.account_id %>)</span>
              </td>
              <td class="p-3 font-mono text-xs text-slate-700">
                <%= hook.reference_id %>
              </td>
              <td class="p-3">
                <% case state %>
                <% when 'requested' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">
                    Requested
                  </span>
                <% when 'pending_install' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    Pending Install
                  </span>
                <% when 'importing' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800">
                    Importing
                  </span>
                <% when 'connected' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800">
                    Connected
                  </span>
                <% when 'needs_reconnect' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-100 text-rose-800">
                    Needs Reconnect
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700">
                    <%= state.humanize %>
                  </span>
                <% end %>
              </td>
              <td class="p-3 font-mono text-xs text-slate-500">
                <%= hook.shopify_sat_tenant_id.presence || '—' %>
              </td>
              <td class="p-3 text-xs text-slate-500">
                <% if hook.settings.to_h['approved_at'].present? %>
                  Approved: <%= Time.zone.parse(hook.settings['approved_at']).strftime('%b %d, %Y') rescue hook.settings['approved_at'] %>
                <% elsif hook.settings.to_h['requested_at'].present? %>
                  Requested: <%= Time.zone.parse(hook.settings['requested_at']).strftime('%b %d, %Y') rescue hook.settings['requested_at'] %>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="p-3 text-right">
                <%= link_to 'Review & Manage', super_admin_shopify_request_path(hook), class: 'text-xs text-blue-600 hover:underline font-medium' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
