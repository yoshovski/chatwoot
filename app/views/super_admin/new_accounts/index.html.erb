<% content_for(:title) { t('super_admin.new_accounts.title') } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title"><%= t('super_admin.new_accounts.title') %></h1>
  <div>
    <% if @flagged_only %>
      <%= link_to t('super_admin.new_accounts.show_all'), super_admin_new_accounts_path, class: 'button' %>
    <% else %>
      <%= link_to t('super_admin.new_accounts.show_flagged'), super_admin_new_accounts_path(flagged: 1), class: 'button' %>
    <% end %>
  </div>
</header>

<section class="main-content__body">
  <p class="text-sm text-slate-600 mb-4"><%= t('super_admin.new_accounts.help') %></p>
  <% rows = @report.visible_rows %>
  <% if rows.empty? %>
    <p class="text-sm text-slate-500"><%= t('super_admin.new_accounts.none') %></p>
  <% else %>
    <div class="overflow-x-auto border border-slate-100 rounded-md">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-xs font-semibold text-slate-600 uppercase">
            <% %w[at account email domains ip trial flags].each do |column| %>
              <th class="p-3"><%= t("super_admin.new_accounts.columns.#{column}") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% rows.each do |row| %>
            <% signup = row.signup %>
            <tr data-test="signup-<%= signup.id %>">
              <td class="p-3 whitespace-nowrap"><%= billing_time(signup.created_at) %></td>
              <td class="p-3">
                <% if signup.account %>
                  <%= link_to signup.account.name.presence || "##{signup.account_id}", super_admin_account_path(signup.account), class: 'text-woot-500 hover:underline' %>
                <% else %>
                  <%= t('super_admin.new_accounts.deleted') %>
                <% end %>
              </td>
              <td class="p-3">
                <%= signup.email || '—' %>
                <div class="text-xs text-slate-500">
                  <%= signup.signup_method %> · <%= signup.email_unconfirmed? ? t('super_admin.new_accounts.unconfirmed') : t('super_admin.new_accounts.confirmed') %>
                </div>
              </td>
              <td class="p-3"><%= signup.trial_domains.join(', ').presence || '—' %></td>
              <td class="p-3"><%= signup.ip || '—' %></td>
              <td class="p-3"><%= signup.trial_granted? ? t('super_admin.new_accounts.trial.granted') : t("super_admin.new_accounts.trial.#{signup.trial_refused_reason || 'none'}") %></td>
              <td class="p-3">
                <% row.flags.each do |flag| %>
                  <span class="inline-block rounded bg-amber-100 text-amber-800 px-2 py-0.5 text-xs mr-1 mb-1" data-test="flag-<%= flag %>"><%= t("super_admin.new_accounts.flags.#{flag}") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="flex gap-2 mt-4">
      <% if @page > 1 && !@flagged_only %>
        <%= link_to t('super_admin.new_accounts.newer'), super_admin_new_accounts_path(page: @page - 1), class: 'button' %>
      <% end %>
      <% if @report.next_page? %>
        <%= link_to t('super_admin.new_accounts.older'), super_admin_new_accounts_path(page: @page + 1), class: 'button' %>
      <% end %>
    </div>
  <% end %>
</section>
