<tr>
  <td style="padding: 0 0 12px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #334155;">{{ greeting | escape }}</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 24px;">
    <p style="margin: 0; font-size: 15px; line-height: 23px; color: #0F172A;">{{ body | escape }}</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 24px;">
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0;">
      <tr>
        <td bgcolor="#2781F6" style="border-radius: 14px; background-color: #2781F6;">
          <a href="{{ button_url }}" style="display: inline-block; padding: 12px 24px; font-size: 14px; line-height: 20px; font-weight: 700; color: #FFFFFF; text-decoration: none;">{{ button_text | escape }}</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% if opt_out_url %}
<tr>
  <td style="padding: 0 0 8px;">
    <p style="margin: 0; font-size: 12px; line-height: 18px; color: #64748B;"><a href="{{ opt_out_url }}" style="color: #64748B;">{{ opt_out_text | escape }}</a></p>
  </td>
</tr>
{% endif %}
