<tr>
  <td style="padding: 0 0 16px;">
    <h1 style="margin: 0; font-size: 24px; line-height: 32px; font-weight: 700; color: #0F172A;">{{ heading | escape }}</h1>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 8px;">
    <p style="margin: 0; font-size: 15px; line-height: 24px; color: #334155;">{{ greeting | escape }}</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 24px;">
    <p style="margin: 0; font-size: 15px; line-height: 24px; color: #334155;">{{ body | escape }}</p>
  </td>
</tr>
{% if questions %}
<tr>
  <td style="padding: 0 0 24px;">
    {% for question in questions %}
    <p style="margin: 0 0 8px; padding: 12px 16px; border-radius: 12px; background-color: #F1F5F9; font-size: 15px; line-height: 22px; color: #0F172A;">{{ question | escape }}</p>
    {% endfor %}
  </td>
</tr>
{% endif %}
{% if code %}
<tr>
  <td style="padding: 0 0 24px;">
    <pre style="margin: 0; padding: 12px 16px; border-radius: 12px; background-color: #0F172A; color: #E2E8F0; font-size: 12px; line-height: 18px; white-space: pre-wrap; word-break: break-all;"><code>{{ code | escape }}</code></pre>
  </td>
</tr>
{% endif %}
<tr>
  <td style="padding: 0 0 24px;">
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0;">
      <tr>
        <td bgcolor="#2781F6" style="border-radius: 14px; background-color: #2781F6;">
          <a href="{{ button_url }}" style="display: inline-block; padding: 13px 28px; font-size: 15px; line-height: 20px; font-weight: 700; color: #FFFFFF; text-decoration: none;">{{ button_text | escape }}</a>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td style="padding: 8px 0 8px; border-top: 1px solid #E2E8F0;">
    <p style="margin: 0; font-size: 12px; line-height: 18px; color: #64748B;"><a href="{{ opt_out_url }}" style="color: #64748B;">{{ opt_out_text | escape }}</a></p>
  </td>
</tr>
